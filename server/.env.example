# Copy to .env ON YOUR SERVER. Never add the real file to Git.
HOST=127.0.0.1
PORT=8787
# Exact origins, comma separated. No trailing slash. Not the full Pages path.
CORS_ORIGIN=https://supremegoogle.github.io,http://localhost:5174
# RouterAI (routerai.ru), not OpenRouter. The real key stays on your server.
AI_BASE_URL=https://routerai.ru/api/v1
AI_MODEL=openai/gpt-4.1-mini
AI_API_KEY=REPLACE_ON_SERVER_ONLY
MAX_REQUESTS_PER_MINUTE=8
MAX_DAILY_REQUESTS=200
# Enable only behind a trusted proxy that overwrites X-Forwarded-For.
TRUST_PROXY=false

# Optional Telegram reminders; the real token stays on the server.
TELEGRAM_BOT_TOKEN=REPLACE_ON_SERVER_ONLY
# Optional: verified bot username avoids a startup getMe dependency.
TELEGRAM_BOT_USERNAME=
REMINDERS_DB=/var/lib/digital-todo/telegram-reminders.json

# Shared-bot webhook mode: preserve the previous application's full URL on server.
# Leave these empty for a dedicated bot using polling.
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_FORWARD_WEBHOOK_URL=
TELEGRAM_FORWARD_WEBHOOK_SECRET=
# If Telegram cannot reach this host reliably (for example a VPS in Russia), pull updates
# instead of receiving the webhook and send all Bot API calls through an HTTPS relay.
# TELEGRAM_MODE=polling
# TELEGRAM_API_BASE=https://<relay-host>/<relay-key>
# TELEGRAM_ALLOWED_UPDATES=message,edited_message,channel_post,edited_channel_post
